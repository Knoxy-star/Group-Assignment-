<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>zw.ac.uz.dpdms</groupId>
    <artifactId>dpdms-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>DPDMS Parent</name>
    <description>Rushinga Provincial Disaster Monitoring and Management System - parent aggregator</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.13</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <!--
        MODULES
        Uncomment each module as its folder is created. Keeping unbuilt
        modules commented out means `mvn clean install` at the root
        never breaks just because someone hasn't pushed their service yet.

        Order matters a little for readability only - Maven builds a
        reactor graph, not this list - but discovery-service and gateway
        should exist first since every other service depends on Eureka
        being reachable at runtime (not at build time).
    -->
    <modules>
        <module>common</module>
        <module>discovery-service</module>
        <module>gateway</module>
        <module>auth-service</module>
        <module>mining-accident-service</module>
        <module>flood-service</module>
        <module>drought-service</module>
        <module>fire-service</module>
        <module>zoonotic-disease-service</module>
        <!-- <module>mining-accident-service</module> -->
        <module>report-service</module>
        <module>alert-service</module>
        <!-- <module>dashboard-service</module> -->
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
