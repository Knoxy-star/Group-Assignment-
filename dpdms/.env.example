# Copy this file to .env and fill in real values before final submission.
# .env itself is gitignored - never commit real secrets.
#
# For local development, every service falls back to safe defaults if
# these aren't set, so the team can run everything without touching
# this file at all until it's time to harden things before submission.
#
# IMPORTANT: JWT_SECRET must be the SAME value across auth-service and
# gateway (and any future service that validates tokens), or tokens
# issued by auth-service will be rejected everywhere else.

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MINUTES=480

# NOTE: don't just "replace" these two - docker-compose.yml hardcodes
# the MySQL root password (root_pass) and mysql-init/01-create-databases.sql
# hardcodes the app user's password (dpdms_pass), neither reads these
# env vars yet. If you change MYSQL_APP_PASSWORD here without also
# editing 01-create-databases.sql to match, every service's DB
# connection will fail with "Access denied" (we hit exactly this while
# testing - the fix was making this file match reality, not the app
# password itself). Leave these as-is unless you update both places
# together.
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_APP_USER=dpdms
MYSQL_APP_PASSWORD=dpdms_pass

# alert-service - email alerts over SMTP (JavaMail). Gmail example:
# MAIL_USERNAME is the sending Gmail address, MAIL_PASSWORD is a 16-char
# App Password (Google Account > Security > App passwords, requires
# 2-Step Verification), not the normal account password.
# EMAIL_ENABLED=false (or unset) means no emails are sent - alerts are
# written to the application log instead, which is the safe default for
# everyone except whoever is actually testing email delivery.
# One sender account, one flat recipient list, for every hazard - the
# system doesn't store anyone's individual email, so alerts are never
# routed to "the recorder's" or "the supervisor's" own address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_sending_gmail_address
MAIL_PASSWORD=replace_with_a_16_char_gmail_app_password
EMAIL_ENABLED=false
EMAIL_RECIPIENTS=comma,separated,recipient,addresses

# alert-service - WhatsApp (Meta WhatsApp Business Cloud API). Same
# on/off switch pattern as email. Needs a Meta developer app + a
# verified WhatsApp Business number - nobody on the team has set this
# up yet, so this stays disabled until someone does.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=replace_once_meta_account_is_verified
WHATSAPP_ACCESS_TOKEN=replace_once_meta_account_is_verified
WHATSAPP_RECIPIENTS=2637XXXXXXXX,2637YYYYYYYY
WHATSAPP_MESSAGE_TYPE=template
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# How each service currently gets these values:
# - Running via IntelliJ/mvn spring-boot:run: set as environment
#   variables in your Run Configuration, or just rely on the dev
#   fallback defaults baked into each application.yml.
# - Running via Docker Compose (once services are containerized):
#   Compose reads a .env file in this same folder automatically.
